# ── PyInstaller 构建产物 ──────────────────────────────────────────────
# build_tmp 是 PyInstaller 的中间目录，dist 是最终 exe；两者都能从 launcher.py
# 重新生成（双击 打包成exe.bat），而且 dist/DRUID.exe 单个就近 200 MB。
build_tmp/
dist/

# ── Python 打包产物 ──────────────────────────────────────────────────
# `pip wheel .` / `pip install -e .` 会在工作区留下这两个目录（源码的完整副本），
# 它们不是源码，入库只会让每次改代码都多出一份假 diff。
build/
*.egg-info/

# ── Python 字节码 ────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── 图件 ─────────────────────────────────────────────────────────────
# 这里出现的 PNG/PDF 全部由 matplotlib 从原始数据生成，体积大（约 19 MB）
# 且二进制无法比对；要留档请把原始批次数据与参数一起保存，而不是图本身。
*.png
*.pdf

# ── 虚拟环境与编辑器 ─────────────────────────────────────────────────
.venv/
venv/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── 临时文件 ─────────────────────────────────────────────────────────
*.tmp
*.bak
~$*
